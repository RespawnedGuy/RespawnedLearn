{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Hauptfenster: eigene Ordner-Befehle, Ordnerauswahl und KI-Anfragen nur an die bekannten Anbieter (Ollama im eigenen Netz auf Port 11434)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://api.openai.com/*" },
        { "url": "https://generativelanguage.googleapis.com/*" },
        { "url": "https://api.perplexity.ai/*" },
        { "url": "http://*:11434/*" }
      ]
    }
  ]
}
