{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RespawnedLearn",
  "version": "../../package.json",
  "identifier": "io.github.respawnedguy.respawnedlearn",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "RespawnedLearn", "width": 1280, "height": 860, "minWidth": 360, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "license": "AGPL-3.0-only",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/RespawnedGuy/RespawnedLearn/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
